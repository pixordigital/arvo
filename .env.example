# ARVO — Environment Variables
# Copy to .env and fill. Coolify injects most of these.

# ─── App ───
ARVO_APP_NAME="ARVO"
ARVO_DEBUG=false
ARVO_APP_URL=http://178.105.181.38:9777
ARVO_JWT_SECRET=change-me-generate-openssl-rand-hex-32
ARVO_JWT_ALGORITHM=HS256
ARVO_JWT_EXPIRE_MINUTES=60
ARVO_CORS_ORIGINS=http://178.105.181.38:9777

# ─── Database — Supabase ARVO (service r4afp9igrytbuir563nsbqem) ───
# After supabase healthy, grab from Coolify → Service → Environment
# Studio on host 9771: http://178.105.181.38:9771
ARVO_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_POSTGRES_PASSWORD@supabase-db:5432/postgres
# For local dev without docker (host-exposed postgres):
# ARVO_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@178.105.181.38:5433/postgres
ARVO_SUPABASE_URL=http://supabasekong-r4afp9igrytbuir563nsbqem.178.105.181.38.sslip.io:8000
ARVO_SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON
ARVO_SUPABASE_SERVICE_KEY=CHANGE_ME_SUPABASE_SERVICE
# Studio exposed:
ARVO_SUPABASE_STUDIO_URL=http://178.105.181.38:9771

# ─── Redis ───
ARVO_REDIS_URL=redis://redis:6379/0

# ─── LLM — OpenRouter (provider padrão) ───
ARVO_LLM_PROVIDER=openrouter
ARVO_OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME
ARVO_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ARVO_OPENAI_API_KEY=
ARVO_ANTHROPIC_API_KEY=
ARVO_GEMINI_API_KEY=

# ─── Security ───
ARVO_HTTPS_ONLY=false
ARVO_RATE_LIMIT_PER_MINUTE=60

# ─── Integrations (placeholders — todos CRMs) ───
ARVO_HUBSPOT_API_KEY=
ARVO_SALESFORCE_CLIENT_ID=
ARVO_SALESFORCE_CLIENT_SECRET=
ARVO_PIPEDRIVE_API_TOKEN=
ARVO_TWENTY_CRM_URL=
ARVO_GMAIL_CLIENT_ID=
ARVO_GMAIL_CLIENT_SECRET=
ARVO_OUTLOOK_CLIENT_ID=
ARVO_OUTLOOK_CLIENT_SECRET=
