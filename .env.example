# ARVO — Environment Variables
# Copy to .env and fill. Coolify injects most of these.

# ─── App ───
ARVO_APP_NAME="ARVO"
ARVO_DEBUG=false
ARVO_APP_URL=http://178.105.181.38:9777
ARVO_JWT_SECRET=change-me-generate-openssl-rand-hex-32
ARVO_JWT_ALGORITHM=HS256
ARVO_JWT_EXPIRE_MINUTES=60
ARVO_CORS_ORIGINS=http://178.105.181.38:9777

# ─── Database ───
# Deploy via docker-compose: the app containers get ARVO_DATABASE_URL from the
# compose file (Postgres service). POSTGRES_PASSWORD is required by compose.
POSTGRES_DB=arvo
POSTGRES_USER=arvo
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24
# APP_MODE=dev (no docker compose) defaults to SQLite: sqlite+aiosqlite:///./arvo.db
# To use your own Postgres/serverless Postgres, set this explicitly:
# ARVO_DATABASE_URL=postgresql+asyncpg://arvo:CHANGE_ME@postgres:5432/arvo
# Supabase (optional): ARVO_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@supabase-db:5432/postgres
ARVO_SUPABASE_URL=http://supabasekong-r4afp9igrytbuir563nsbqem.178.105.181.38.sslip.io:8000
ARVO_SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON
ARVO_SUPABASE_SERVICE_KEY=CHANGE_ME_SUPABASE_SERVICE
# Studio exposed:
ARVO_SUPABASE_STUDIO_URL=http://178.105.181.38:9771

# ─── Redis — SASL (ACL default user + senha) ───
# Produção: ARVO_REDIS_PASSWORD gerada via `openssl rand -hex 16`
# SASL: redis://default:senha@redis:6379/0  (default user) ou redis://arvo:senha@...
ARVO_REDIS_URL=redis://:changeme@redis:6379/0
ARVO_REDIS_USERNAME=default
ARVO_REDIS_PASSWORD=changeme

# ─── LLM — OpenRouter (provider padrão) ───
ARVO_OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME
ARVO_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Security ───
ARVO_HTTPS_ONLY=false
ARVO_RATE_LIMIT_PER_MINUTE=60

# ─── Integrations (placeholders — todos CRMs) ───
# ATENÇÃO: CRM/e-mail retornam 501 nesta versão; chave não habilita sync. Entrada real: CSV/upload.
ARVO_HUBSPOT_API_KEY=
ARVO_SALESFORCE_CLIENT_ID=
ARVO_SALESFORCE_CLIENT_SECRET=
ARVO_PIPEDRIVE_API_TOKEN=
ARVO_TWENTY_CRM_URL=
ARVO_GMAIL_CLIENT_ID=
ARVO_GMAIL_CLIENT_SECRET=
ARVO_OUTLOOK_CLIENT_ID=
ARVO_OUTLOOK_CLIENT_SECRET=

# ─── ARVO ↔ AIOS (Fase 1 — off por padrão) ───
ARVO_AIOS_INTEGRATION_ENABLED=false
ARVO_AIOS_BASE_URL=
ARVO_AIOS_SERVICE_KEY_ID=
ARVO_AIOS_SERVICE_KEY=
# ARVO_AIOS_ALLOWED_ORGS=
# ARVO_USE_ARQ_WORKER=false
